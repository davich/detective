# Copy this file to .env and fill in your OpenRouter API key.
# Get a key at https://openrouter.ai/keys

OPENROUTER_API_KEY=

# Model slug on OpenRouter. Check https://openrouter.ai/models for the exact
# current DeepSeek slug you have access to (e.g. deepseek/deepseek-chat,
# deepseek/deepseek-chat-v3.1, or whatever "V4 flash" resolves to for you).
OPENROUTER_MODEL=deepseek/deepseek-chat

PORT=3000
